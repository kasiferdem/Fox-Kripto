# -----------------------------------------
# FOX-KRİPTO SİSTEM KONFİGÜRASYONU
# -----------------------------------------
# OpenAI / OpenRouter LLM Key
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Supabase PostgreSQL Database
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Telegram Bot API (Bildirim & Human-in-the-Loop Onay)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Borsa Bağlantısı (CCXT - Binance / OKX / Bybit)
EXCHANGE_ID=binance
EXCHANGE_API_KEY=your_exchange_api_key_here
EXCHANGE_SECRET_KEY=your_exchange_secret_key_here
EXCHANGE_TESTNET=true

# Risk & Bütçe Kuralları
MAX_TRADE_BUDGET_PERCENT=10.0
MIN_STOP_LOSS_PERCENT=3.0
MAX_STOP_LOSS_PERCENT=5.0
